{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "citysim://integration/industrial-l04-source-stage-handoff-v1",
  "title": "Industrial L4 directional source-stage handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stage",
    "identity",
    "lineage",
    "authorities",
    "inputs",
    "launch",
    "completion",
    "sourceReady",
    "productionSelected"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "stage": {
      "enum": [
        "launch_bound",
        "source_candidate"
      ]
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publishedBaseline",
        "cellCandidateCommit"
      ],
      "properties": {
        "publishedBaseline": {
          "$ref": "#/$defs/commit"
        },
        "cellCandidateCommit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract010",
        "contract021",
        "directionBridge",
        "appearanceLock",
        "lockedMaterialMapping",
        "postLockProductionAuthority",
        "nonAliasInput"
      ],
      "properties": {
        "contract010": {
          "$ref": "#/$defs/artifact"
        },
        "contract021": {
          "$ref": "#/$defs/artifact"
        },
        "directionBridge": {
          "$ref": "#/$defs/committedArtifact"
        },
        "appearanceLock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "documentPath",
            "commit",
            "documentSha256",
            "northProcessASourceSha256",
            "northProcessADecodedRgbaSha256"
          ],
          "properties": {
            "documentPath": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "$ref": "#/$defs/commit"
            },
            "documentSha256": {
              "$ref": "#/$defs/sha256"
            },
            "northProcessASourceSha256": {
              "$ref": "#/$defs/sha256"
            },
            "northProcessADecodedRgbaSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "lockedMaterialMapping": {
          "$ref": "#/$defs/artifact"
        },
        "postLockProductionAuthority": {
          "$ref": "#/$defs/committedArtifact"
        },
        "nonAliasInput": {
          "allOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "properties": {
                "path": {
                  "const": "docs/production/evidence/INTEGRATION/industrial-l04-accepted-master-non-alias-input-v1.json"
                }
              }
            }
          ]
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prelaunchHandoff",
        "frozenInputManifest",
        "runnerContract",
        "outputRoot"
      ],
      "properties": {
        "prelaunchHandoff": {
          "$ref": "#/$defs/artifact"
        },
        "frozenInputManifest": {
          "$ref": "#/$defs/artifact"
        },
        "runnerContract": {
          "$ref": "#/$defs/artifact"
        },
        "outputRoot": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(Native/CitySimNative/WorldArt|docs/production/evidence)/"
        }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guardReceipt",
        "result",
        "authorizedProcesses",
        "isolatedOutputRoots"
      ],
      "properties": {
        "guardReceipt": {
          "$ref": "#/$defs/artifact"
        },
        "result": {
          "const": "PASS"
        },
        "authorizedProcesses": {
          "type": "array",
          "items": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "uniqueItems": true
        },
        "isolatedOutputRoots": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "A": {
              "type": "string",
              "minLength": 1
            },
            "B": {
              "type": "string",
              "minLength": 1
            },
            "C": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "completion": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/completion"
        }
      ]
    },
    "sourceReady": {
      "type": "boolean"
    },
    "productionSelected": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "launch_bound"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "completion": {
            "type": "null"
          },
          "sourceReady": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "source_candidate"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "completion": {
            "$ref": "#/$defs/completion"
          },
          "sourceReady": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "identity": {
            "properties": {
              "direction": {
                "const": "north"
              }
            },
            "required": [
              "direction"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "launch": {
            "properties": {
              "authorizedProcesses": {
                "const": [
                  "B",
                  "C"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "launch": {
            "properties": {
              "authorizedProcesses": {
                "const": [
                  "A",
                  "B",
                  "C"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "committedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "commit",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "direction",
        "branch",
        "family",
        "level",
        "variant",
        "logicalID",
        "sourceKey",
        "orientationTransform",
        "fallbackSourceKey"
      ],
      "properties": {
        "taskId": {
          "enum": [
            "PLAY-027",
            "PLAY-079",
            "PLAY-080",
            "PLAY-081"
          ]
        },
        "direction": {
          "enum": [
            "north",
            "east",
            "south",
            "west"
          ]
        },
        "branch": {
          "type": "string"
        },
        "family": {
          "const": "industrial"
        },
        "level": {
          "const": 4
        },
        "variant": {
          "const": 0
        },
        "logicalID": {
          "type": "string"
        },
        "sourceKey": {
          "type": "string",
          "pattern": "^industrial_l04/variant-0/(north|east|south|west)/source-v[0-9]+$"
        },
        "orientationTransform": {
          "const": "none"
        },
        "fallbackSourceKey": {
          "type": "null"
        }
      },
      "oneOf": [
        {
          "properties": {
            "taskId": {
              "const": "PLAY-027"
            },
            "direction": {
              "const": "north"
            },
            "branch": {
              "const": "codex/citysim-world-art"
            },
            "logicalID": {
              "const": "industrial_l04_v0_north"
            }
          }
        },
        {
          "properties": {
            "taskId": {
              "const": "PLAY-079"
            },
            "direction": {
              "const": "east"
            },
            "branch": {
              "const": "codex/citysim-world-art-east"
            },
            "logicalID": {
              "const": "industrial_l04_v0_east"
            }
          }
        },
        {
          "properties": {
            "taskId": {
              "const": "PLAY-080"
            },
            "direction": {
              "const": "south"
            },
            "branch": {
              "const": "codex/citysim-world-art-south"
            },
            "logicalID": {
              "const": "industrial_l04_v0_south"
            }
          }
        },
        {
          "properties": {
            "taskId": {
              "const": "PLAY-081"
            },
            "direction": {
              "const": "west"
            },
            "branch": {
              "const": "codex/citysim-world-art-west"
            },
            "logicalID": {
              "const": "industrial_l04_v0_west"
            }
          }
        }
      ]
    },
    "raster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "decodedRgbaSha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "decodedRgbaSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "semantic",
        "provenance"
      ],
      "properties": {
        "raw": {
          "$ref": "#/$defs/raster"
        },
        "semantic": {
          "$ref": "#/$defs/raster"
        },
        "provenance": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canvasPixels",
        "groundPivotSource",
        "frontageSocketSource",
        "frontageEdge",
        "supportedOrientation",
        "contactDeclaration",
        "shadowDirection",
        "hiddenRgbPixelCount",
        "nearChromaPixelCount"
      ],
      "properties": {
        "canvasPixels": {
          "const": [
            1536,
            1024
          ]
        },
        "groundPivotSource": {
          "const": [
            768,
            896
          ]
        },
        "frontageSocketSource": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "frontageEdge": {
          "enum": [
            "north",
            "east",
            "south",
            "west"
          ]
        },
        "supportedOrientation": {
          "enum": [
            "north-facing-authored",
            "east-facing-authored",
            "south-facing-authored",
            "west-facing-authored"
          ]
        },
        "contactDeclaration": {
          "const": "registered_ground_pivot"
        },
        "shadowDirection": {
          "const": "southeast"
        },
        "hiddenRgbPixelCount": {
          "const": 0
        },
        "nearChromaPixelCount": {
          "const": 0
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateCommit",
        "processes",
        "lods",
        "registration",
        "validationReceipt",
        "reviewManifest",
        "rejectedAttemptInventory"
      ],
      "properties": {
        "candidateCommit": {
          "$ref": "#/$defs/commit"
        },
        "processes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "A",
            "B",
            "C"
          ],
          "properties": {
            "A": {
              "$ref": "#/$defs/process"
            },
            "B": {
              "$ref": "#/$defs/process"
            },
            "C": {
              "$ref": "#/$defs/process"
            }
          }
        },
        "lods": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/raster"
              },
              {
                "type": "object",
                "required": [
                  "detail"
                ],
                "properties": {
                  "detail": {
                    "enum": [
                      "city",
                      "neighborhood",
                      "block"
                    ]
                  }
                }
              }
            ]
          }
        },
        "registration": {
          "$ref": "#/$defs/registration"
        },
        "validationReceipt": {
          "$ref": "#/$defs/artifact"
        },
        "reviewManifest": {
          "$ref": "#/$defs/artifact"
        },
        "rejectedAttemptInventory": {
          "$ref": "#/$defs/artifact"
        }
      }
    }
  }
}
