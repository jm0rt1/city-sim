        "sourceAcceptance": {
          "const": false
        },
        "rendererAdmission": {
          "const": false
        },
        "runtimeActivation": {
          "const": false
        },
        "shippingMutation": {
          "const": false
        },
        "productionSelection": {
          "const": false
        },
        "appLaunch": {
          "const": false
        },
        "qaDisposition": {
          "const": false
        },
        "integration": {
          "const": false
        },
        "push": {
          "const": false
        }
      }
