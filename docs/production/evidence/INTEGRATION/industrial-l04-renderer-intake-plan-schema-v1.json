        "exclusiveOutputRoot": {
          "type": "string",
          "pattern": "^docs/production/evidence/PLAY-073/industrial-l04-renderer-intake-plan-v1/(north|east|south|west)$"
        },
        "failureIsolation": {
          "const": "return_this_direction_only"
        },
        "shippingMutationAllowed": {
          "const": false
        }
      }
