{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "citysim://play-073/industrial-l04-direction-quarantine-v1",
  "title": "Industrial L4 renderer direction quarantine packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "family",
    "level",
    "variant",
    "direction",
    "logicalID",
    "governingContract",
    "directionBridge",
    "appearanceLock",
    "source",
    "lods",
    "provenance",
    "registration",
    "transformFingerprints",
    "sourceReady",
    "productionSelected",
    "quarantineDisposition"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "family": {
      "const": "industrial"
    },
    "level": {
      "const": 4
    },
    "variant": {
      "const": 0
    },
    "direction": {
      "enum": [
        "north",
        "east",
        "south",
        "west"
      ]
    },
    "logicalID": {
      "type": "string",
      "pattern": "^industrial_l04_v0_(north|east|south|west)$"
    },
    "governingContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "revision",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "docs/production/decisions/CONTRACT-021-parallel-directional-art-cells.md"
        },
        "revision": {
          "const": 2
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "directionBridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentPath",
        "commit",
        "documentSha256",
        "canonicalMappingSha256",
        "coordinateSystem"
      ],
      "properties": {
        "documentPath": {
          "const": "docs/production/evidence/INTEGRATION/INDUSTRIAL-L04-DIRECTIONAL-BRIDGE-V06-ACCEPTANCE.md"
        },
        "commit": {
          "const": "3e01ca6738d7574718f9aeff4b66771eee109feb"
        },
        "documentSha256": {
          "const": "9765d88191d8a555de41dcccfb83b3da16d8f1423d534d66312ffa98a4615208"
        },
        "canonicalMappingSha256": {
          "const": "5695927b78ceaba52eda6f78f23b0e719623b492f5c5ee36845235fea3c06ff7"
        },
        "coordinateSystem": {
          "const": "citysim_source_pixels_v1"
        }
      }
    },
    "appearanceLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentPath",
        "commit",
        "documentSha256",
        "northProcessASourceSha256",
        "northProcessADecodedRgbaSha256"
      ],
      "properties": {
        "documentPath": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "documentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "northProcessASourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "northProcessADecodedRgbaSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateCommit",
        "sourceKey",
        "decodedRgbaSha256",
        "authoredGeometrySha256",
        "componentManifestSha256",
        "fallbackSourceKey"
      ],
      "properties": {
        "candidateCommit": {
          "$ref": "#/$defs/commit"
        },
        "sourceKey": {
          "type": "string",
          "minLength": 1
        },
        "decodedRgbaSha256": {
          "$ref": "#/$defs/sha256"
        },
        "authoredGeometrySha256": {
          "$ref": "#/$defs/sha256"
        },
        "componentManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "fallbackSourceKey": {
          "type": "null"
        }
      }
    },
    "lods": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "detail",
          "normalizedRgbaSha256",
          "canvasPixels"
        ],
        "properties": {
          "detail": {
            "enum": [
              "city",
              "neighborhood",
              "block"
            ]
          },
          "normalizedRgbaSha256": {
            "$ref": "#/$defs/sha256"
          },
          "canvasPixels": {
            "$ref": "#/$defs/pixelPair"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceManifest",
        "toolchain",
        "normalizationReceipt"
      ],
      "properties": {
        "sourceManifest": {
          "$ref": "#/$defs/artifact"
        },
        "toolchain": {
          "$ref": "#/$defs/artifact"
        },
        "normalizationReceipt": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "footprintTiles",
        "canvasPixels",
        "groundPivotSource",
        "frontageSocketSource",
        "frontageEdge",
        "supportedOrientation",
        "occupiedBounds",
        "groundContactPolygonWorld",
        "contactDeclaration",
        "shadowDirection",
        "alpha"
      ],
      "properties": {
        "footprintTiles": {
          "type": "array",
          "prefixItems": [
            {
              "const": 1
            },
            {
              "const": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "canvasPixels": {
          "type": "array",
          "prefixItems": [
            {
              "const": 1536
            },
            {
              "const": 1024
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "groundPivotSource": {
          "type": "array",
          "prefixItems": [
            {
              "const": 768
            },
            {
              "const": 896
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "frontageSocketSource": {
          "$ref": "#/$defs/pixelPair"
        },
        "frontageEdge": {
          "enum": [
            "north",
            "east",
            "south",
            "west"
          ]
        },
        "supportedOrientation": {
          "type": "string",
          "pattern": "^(north|east|south|west)-facing-authored$"
        },
        "occupiedBounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minX",
            "minY",
            "maxX",
            "maxY"
          ],
          "properties": {
            "minX": {
              "type": "integer",
              "minimum": 0
            },
            "minY": {
              "type": "integer",
              "minimum": 0
            },
            "maxX": {
              "type": "integer",
              "maximum": 1536
            },
            "maxY": {
              "type": "integer",
              "maximum": 1024
            }
          }
        },
        "groundContactPolygonWorld": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/numberPair"
          }
        },
        "contactDeclaration": {
          "const": "registered_ground_pivot"
        },
        "shadowDirection": {
          "const": "southeast"
        },
        "alpha": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nonzeroPixelCount",
            "hiddenRgbPixelCount",
            "nearChromaPixelCount"
          ],
          "properties": {
            "nonzeroPixelCount": {
              "type": "integer",
              "minimum": 1
            },
            "hiddenRgbPixelCount": {
              "const": 0
            },
            "nearChromaPixelCount": {
              "const": 0
            }
          }
        }
      }
    },
    "transformFingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "rotate90",
        "rotate180",
        "rotate270",
        "mirrorX",
        "mirrorY",
        "mirrorDiagonal",
        "mirrorAntiDiagonal"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/sha256"
        },
        "rotate90": {
          "$ref": "#/$defs/sha256"
        },
        "rotate180": {
          "$ref": "#/$defs/sha256"
        },
        "rotate270": {
          "$ref": "#/$defs/sha256"
        },
        "mirrorX": {
          "$ref": "#/$defs/sha256"
        },
        "mirrorY": {
          "$ref": "#/$defs/sha256"
        },
        "mirrorDiagonal": {
          "$ref": "#/$defs/sha256"
        },
        "mirrorAntiDiagonal": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceReady": {
      "const": true
    },
    "productionSelected": {
      "const": false
    },
    "quarantineDisposition": {
      "const": "accepted_direction_quarantine"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "pixelPair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "numberPair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
