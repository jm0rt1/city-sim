{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "citysim://integration/model-route-v1",
  "title": "CitySim model route v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "routeId",
    "taskId",
    "packetKind",
    "classification",
    "model",
    "effort",
    "rationale",
    "authority",
    "assignment",
    "pathPolicy",
    "boundedDeliverable",
    "validation",
    "expectedResult",
    "escalationTriggers",
    "stopCondition",
    "independentReviewer",
    "context"
  ],
  "properties": {
    "schema": { "const": 1 },
    "routeId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "pattern": "^PLAY-[0-9]{3}$" },
    "packetKind": {
      "enum": ["authority", "implementation", "mechanical", "local_debug", "acceptance"]
    },
    "classification": {
      "enum": ["FRONTIER_AUTHORITY", "LUNA_IMPLEMENTATION", "LUNA_MECHANICAL", "LUNA_LOCAL_DEBUG"]
    },
    "model": { "enum": ["gpt-5.6-sol", "gpt-5.6-luna"] },
    "effort": { "enum": ["medium", "high", "max"] },
    "rationale": { "type": "string", "minLength": 1 },
    "authority": { "$ref": "#/$defs/authority" },
    "assignment": { "$ref": "#/$defs/assignment" },
    "pathPolicy": { "$ref": "#/$defs/pathPolicy" },
    "boundedDeliverable": { "type": "string", "minLength": 1 },
    "validation": { "$ref": "#/$defs/validation" },
    "expectedResult": { "$ref": "#/$defs/expectedResult" },
    "escalationTriggers": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/escalationTrigger" }
    },
    "stopCondition": { "type": "string", "minLength": 1 },
    "independentReviewer": { "$ref": "#/$defs/reviewer" },
    "context": { "$ref": "#/$defs/context" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" }
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityCommit", "baseCommit", "claim", "immutableInputs"],
      "properties": {
        "authorityCommit": { "$ref": "#/$defs/gitCommit" },
        "baseCommit": { "$ref": "#/$defs/gitCommit" },
        "claim": { "$ref": "#/$defs/fileBinding" },
        "immutableInputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fileBinding" }
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threadId",
        "featureAuthorThreadId",
        "sharedAuthorityOwnership",
        "finalQAOwnership",
        "subjectiveJudgmentRequired"
      ],
      "properties": {
        "threadId": { "type": "string", "minLength": 1 },
        "featureAuthorThreadId": { "type": ["string", "null"] },
        "sharedAuthorityOwnership": { "type": "boolean" },
        "finalQAOwnership": { "type": "boolean" },
        "subjectiveJudgmentRequired": { "type": "boolean" }
      }
    },
    "pathPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimOwnedRoots", "allowed", "forbidden"],
      "properties": {
        "claimOwnedRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        }
      }
    },
    "gateOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threadId", "role"],
      "properties": {
        "threadId": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "fullGateOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threadId", "role", "model", "effort"],
      "properties": {
        "threadId": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "model": { "const": "gpt-5.6-sol" },
        "effort": { "const": "high" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focusedGateOwner", "focusedCommands", "fullGateOwner", "fullCommands"],
      "properties": {
        "focusedGateOwner": { "$ref": "#/$defs/gateOwner" },
        "focusedCommands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "fullGateOwner": { "$ref": "#/$defs/fullGateOwner" },
        "fullCommands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "expectedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidencePaths", "commitRequired", "commitMessagePattern"],
      "properties": {
        "evidencePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "commitRequired": { "type": "boolean" },
        "commitMessagePattern": { "type": "string", "minLength": 1 }
      }
    },
    "escalationTrigger": {
      "enum": [
        "shared_contract_or_schema_decision",
        "unresolved_product_visual_or_interaction_judgment",
        "path_outside_claim",
        "baseline_or_candidate_identity_mismatch",
        "failure_outside_focused_scope",
        "save_or_migration_uncertainty",
        "cross_lane_semantic_conflict",
        "two_unsuccessful_repair_attempts",
        "subjective_acceptance_required"
      ]
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "threadId", "model", "effort"],
      "properties": {
        "required": { "type": "boolean" },
        "threadId": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "effort": { "type": ["string", "null"] }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "packet", "verifiedHashes"],
      "properties": {
        "mode": { "enum": ["full_authority_read", "compact_continuation"] },
        "packet": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/fileBinding" }
          ]
        },
        "verifiedHashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fileBinding" }
        }
      }
    }
  }
}
