{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "citysim://integration/industrial-l04-renderer-intake-plan-v1",
  "title": "Industrial L4 candidate-neutral Renderer intake plan v1",
  "type": "object",
