            "sourceAdmission": {
              "$ref": "#/$defs/nullableArtifact"
            },
            "quarantineReceipt": {
              "$ref": "#/$defs/nullableArtifact"
            }
          }
        }
      }
    },
    "directionJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "direction",
