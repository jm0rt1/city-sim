{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "citysim://residential-l01-variant1/north-process-a-schedule-v1",
  "title": "Residential L1 variant-one North Process-A schedule v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "batch", "phase", "issuedAt", "integrationAuthorityCommit",
    "familyContract", "claim", "worker", "startupReceipt", "executable",
    "orchestrator", "child", "computeEnvelope", "northGrant",
    "blockedProcesses", "blockedDirections", "exclusiveRoots",
    "integrationProcessReceipt", "productionBoundary"
  ],
  "properties": {
    "schema": {"const": 1},
    "batch": {"const": "residential-l01-variant1-v1"},
    "phase": {"const": "prelock_north_a"},
    "issuedAt": {"type": "string", "format": "date-time"},
    "integrationAuthorityCommit": {"$ref": "#/$defs/gitCommit"},
    "familyContract": {"$ref": "#/$defs/fileBinding"},
    "claim": {"$ref": "#/$defs/fileBinding"},
    "worker": {
      "type": "object", "additionalProperties": false,
      "required": ["threadId", "branch", "worktree", "head"],
      "properties": {
        "threadId": {"const": "019f96e0-3793-7542-9172-060a9ca09b0a"},
        "branch": {"const": "codex/citysim-world-art"},
        "worktree": {"const": "/Users/James/.codex/worktrees/0648/city-sim"},
        "head": {"$ref": "#/$defs/gitCommit"}
      }
    },
    "startupReceipt": {"$ref": "#/$defs/fileBinding"},
    "executable": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "architecture", "version", "buildHash", "factoryStartup", "autoexecDisabled"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "architecture": {"enum": ["arm64", "x86_64"]},
        "version": {"type": "string", "minLength": 1},
        "buildHash": {"type": "string", "minLength": 1},
        "factoryStartup": {"const": true},
        "autoexecDisabled": {"const": true}
      }
    },
    "orchestrator": {"$ref": "#/$defs/fileBinding"},
    "child": {"$ref": "#/$defs/fileBinding"},
    "computeEnvelope": {
      "type": "object", "additionalProperties": false,
      "required": ["maximumSimultaneousDCCProcesses", "slotIds", "queueOrder"],
      "properties": {
        "maximumSimultaneousDCCProcesses": {"const": 1},
        "slotIds": {"const": ["residential-v1-north-a-slot-0"]},
        "queueOrder": {"const": ["north:A"]}
      }
    },
    "northGrant": {
      "type": "object", "additionalProperties": false,
      "required": ["grantId", "direction", "process", "state", "slotId", "maximumChildStarts", "orchestratorOnly", "directLowLevelInvocationAllowed", "pixelProductionAuthorized"],
      "properties": {
        "grantId": {"type": "string", "minLength": 1},
        "direction": {"const": "north"},
        "process": {"const": "A"},
        "state": {"const": "granted"},
        "slotId": {"const": "residential-v1-north-a-slot-0"},
        "maximumChildStarts": {"const": 1},
        "orchestratorOnly": {"const": true},
        "directLowLevelInvocationAllowed": {"const": false},
        "pixelProductionAuthorized": {"const": true}
      }
    },
    "blockedProcesses": {"const": ["B", "C"]},
    "blockedDirections": {"const": ["east", "south", "west"]},
    "exclusiveRoots": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceRoot", "evidenceRoot", "outputRoot", "attemptMarker"],
      "properties": {
        "sourceRoot": {"type": "string", "minLength": 1},
        "evidenceRoot": {"type": "string", "minLength": 1},
        "outputRoot": {"type": "string", "minLength": 1},
        "attemptMarker": {"type": "string", "minLength": 1}
      }
    },
    "integrationProcessReceipt": {"$ref": "#/$defs/committedFileBinding"},
    "productionBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["pixelsAuthorizedByGrantId", "requireOutputRootAbsent", "requireAttemptMarkerAbsent", "maximumAttempts", "appearanceLockPublished", "sourceAuthority", "productionSelected", "siblingPixelsAuthorized"],
      "properties": {
        "pixelsAuthorizedByGrantId": {"type": "string", "minLength": 1},
        "requireOutputRootAbsent": {"const": true},
        "requireAttemptMarkerAbsent": {"const": true},
        "maximumAttempts": {"const": 1},
        "appearanceLockPublished": {"const": false},
        "sourceAuthority": {"const": false},
        "productionSelected": {"const": false},
        "siblingPixelsAuthorized": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "fileBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "committedFileBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "commit"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "commit": {"$ref": "#/$defs/gitCommit"}
      }
    }
  }
}
