{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "citysim://industrial-l04/parallel-execution-schedule-v1",
  "title": "Industrial L4 parallel execution schedule v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "batch",
    "phase",
    "issuedAt",
    "integrationAuthorityCommit",
    "familyContract",
    "appearanceLock",
    "sourceProductionProfile",
    "computeEnvelope",
    "directionGrants"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "batch": {
      "const": "industrial_l04_directional_family"
    },
    "phase": {
      "enum": [
        "prelock_north_a",
        "postlock_abc"
      ]
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "integrationAuthorityCommit": {
      "$ref": "#/$defs/gitCommit"
    },
    "familyContract": {
      "$ref": "#/$defs/fileBinding"
    },
    "appearanceLock": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/fileBinding"
        }
      ]
    },
    "sourceProductionProfile": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/fileBinding"
        }
      ]
    },
    "computeEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumSimultaneousDCCProcesses",
        "slotIds",
        "queueOrder"
      ],
      "properties": {
        "maximumSimultaneousDCCProcesses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "slotIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "queueOrder": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(north|east|south|west):(A|B|C)$"
          }
        }
      }
    },
    "directionGrants": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/directionGrant"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "processGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grantId",
        "process",
        "state",
        "slotId",
        "maximumChildStarts",
        "orchestratorOnly",
        "directLowLevelInvocationAllowed"
      ],
      "properties": {
        "grantId": {
          "type": "string",
          "minLength": 1
        },
        "process": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "state": {
          "enum": [
            "granted",
            "blocked"
          ]
        },
        "slotId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "maximumChildStarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "orchestratorOnly": {
          "type": "boolean"
        },
        "directLowLevelInvocationAllowed": {
          "type": "boolean"
        }
      }
    },
    "directionGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "claim",
        "branch",
        "claimSha256",
        "baseCommit",
        "orchestrator",
        "exclusiveRoots",
        "processes"
      ],
      "properties": {
        "direction": {
          "enum": [
            "north",
            "east",
            "south",
            "west"
          ]
        },
        "claim": {
          "pattern": "^PLAY-[0-9]{3}$"
        },
        "branch": {
          "type": "string",
          "pattern": "^codex/citysim-world-art(-east|-south|-west)?$"
        },
        "claimSha256": {
          "$ref": "#/$defs/sha256"
        },
        "baseCommit": {
          "$ref": "#/$defs/gitCommit"
        },
        "orchestrator": {
          "$ref": "#/$defs/fileBinding"
        },
        "exclusiveRoots": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "processes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/processGrant"
          }
        }
      }
    }
  }
}
