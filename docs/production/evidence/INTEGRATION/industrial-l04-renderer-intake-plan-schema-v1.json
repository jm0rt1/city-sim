          "properties": {
            "raw": {
              "$ref": "#/$defs/nullableArtifact"
            },
            "provenance": {
              "$ref": "#/$defs/nullableArtifact"
            },
            "normalization": {
              "$ref": "#/$defs/nullableArtifact"
            },
            "descriptor": {
              "$ref": "#/$defs/nullableArtifact"
            },
            "contact": {
              "$ref": "#/$defs/nullableArtifact"
            },
            "review": {
              "$ref": "#/$defs/nullableArtifact"
            }
          }
        }
