{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "citysim://integration/industrial-l04-prelock-runner-handoff-v1",
  "title": "Industrial L4 directional pre-lock runner handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "direction",
    "branch",
    "baselineCommit",
    "governingContract",
    "acceptedPredesign",
    "runner",
    "guardEvidence",
    "appearanceLock",
    "validation",
    "renderInvocations",
    "pixelFiles",
    "state",
    "sourceReady",
    "productionSelected"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "taskId": {
      "enum": [
        "PLAY-079",
        "PLAY-080",
        "PLAY-081"
      ]
    },
    "direction": {
      "enum": [
        "east",
        "south",
        "west"
      ]
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "baselineCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "governingContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "docs/production/decisions/CONTRACT-021-parallel-directional-art-cells.md"
        },
        "sha256": {
          "const": "f80844c928d904498510b8b151381f40315e072d52d81695aafcd6b91081ae4c"
        }
      }
    },
    "acceptedPredesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoffPath",
        "handoffSha256",
        "inputHashes"
      ],
      "properties": {
        "handoffPath": {
          "type": "string",
          "minLength": 1
        },
        "handoffSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inputHashes": {
          "type": "object",
          "minProperties": 3,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractPath",
        "contractSha256",
        "driverPath",
        "driverSha256",
        "validatorHashes",
        "sourceRoot",
        "evidenceRoot"
      ],
      "properties": {
        "contractPath": {
          "type": "string",
          "minLength": 1
        },
        "contractSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "driverPath": {
          "type": "string",
          "minLength": 1
        },
        "driverSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "validatorHashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "sourceRoot": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRoot": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "guardEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missingLockRejected",
        "wrongLockRejected",
        "rejectionStage",
        "blenderProcessLaunches",
        "blenderRenderApiCalls",
        "imageGenInvocations",
        "normalizerInvocations",
        "contactSheetInvocations"
      ],
      "properties": {
        "missingLockRejected": {
          "const": true
        },
        "wrongLockRejected": {
          "const": true
        },
        "rejectionStage": {
          "const": "before_renderer_launch"
        },
        "blenderProcessLaunches": {
          "const": 0
        },
        "blenderRenderApiCalls": {
          "const": 0
        },
        "imageGenInvocations": {
          "const": 0
        },
        "normalizerInvocations": {
          "const": 0
        },
        "contactSheetInvocations": {
          "const": 0
        }
      }
    },
    "appearanceLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentPath",
        "commit",
        "documentSha256",
        "northProcessASourceSha256",
        "northProcessADecodedRgbaSha256"
      ],
      "properties": {
        "documentPath": {
          "type": "null"
        },
        "commit": {
          "type": "null"
        },
        "documentSha256": {
          "type": "null"
        },
        "northProcessASourceSha256": {
          "type": "null"
        },
        "northProcessADecodedRgbaSha256": {
          "type": "null"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runnerStaticPass",
        "guardPass",
        "repeatIdentityPass",
        "rgba",
        "literal192",
        "abcIdentity",
        "normalization"
      ],
      "properties": {
        "runnerStaticPass": {
          "const": true
        },
        "guardPass": {
          "const": true
        },
        "repeatIdentityPass": {
          "const": true
        },
        "rgba": {
          "const": "not_run"
        },
        "literal192": {
          "const": "not_run"
        },
        "abcIdentity": {
          "const": "not_run"
        },
        "normalization": {
          "const": "not_run"
        }
      }
    },
    "renderInvocations": {
      "const": 0
    },
    "pixelFiles": {
      "const": 0
    },
    "state": {
      "const": "prelock_runner_ready"
    },
    "sourceReady": {
      "const": false
    },
    "productionSelected": {
      "const": false
    }
  }
}
