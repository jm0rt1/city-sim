        "atlasSlot": {
          "type": "string",
          "pattern": "^industrial_l04_v0_(north|east|south|west)/(city|neighborhood|block)$"
        },
        "canvasPixels": {
          "enum": [
            [
              256,
              171
            ],
            [
              512,
              342
            ],
            [
              1024,
              683
            ]
          ]
        }
      }
    },
    "directionIntake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "sourceTask",
        "logicalID",
        "lods",
