  "required": [
    "schemaVersion",
    "receiptType",
    "disposition",
    "mode",
    "request",
    "authority",
    "baseFixture",
    "rendererCandidate",
    "integrationAdmission",
    "directionBridge",
    "atomicDirectionGate",
    "derivativePlans",
    "expectedCaptureTree",
    "sideEffects",
