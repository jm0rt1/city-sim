{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PLAY-096 per-identity per-direction handoff row",
  "type": "object",
  "additionalProperties": false,
  "required": ["logical_id", "direction", "identity_direction_key", "raw", "record", "lods", "south_reference", "provenance", "registration", "alias", "readiness"],
  "properties": {
    "logical_id": {"type": "string", "minLength": 1},
    "direction": {"enum": ["north", "east", "south", "west"]},
    "identity_direction_key": {"type": "string", "pattern": "^[a-z0-9_]+:(north|east|south|west)$"},
    "raw": {"$ref": "#/$defs/digest"},
    "record": {"$ref": "#/$defs/digest"},
    "lods": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "#/$defs/lodDigest"}
    },
    "south_reference": {"$ref": "#/$defs/binding"},
    "provenance": {"$ref": "prompt-provenance.schema.json"},
    "registration": {"$ref": "#/$defs/registration"},
    "alias": {
      "type": "object", "additionalProperties": false,
      "required": ["alias_of", "transform"],
      "properties": {"alias_of": {"type": ["string", "null"]}, "transform": {"const": "none"}}
    },
    "readiness": {"$ref": "#/$defs/readiness"}
  },
  "$defs": {
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": ["string", "null"]}, "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}
    },
    "digest": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "path", "sha256"],
      "properties": {
        "status": {"enum": ["not_generated", "source_candidate"]},
        "path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "lodDigest": {
      "type": "object", "additionalProperties": false,
      "required": ["lod", "status", "path", "sha256"],
      "properties": {"lod": {"enum": ["city", "neighborhood", "block"]}, "status": {"enum": ["not_generated", "source_candidate"]}, "path": {"type": ["string", "null"]}, "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}
    },
    "registration": {
      "type": "object", "additionalProperties": false,
      "required": ["registration_contract", "registration_profile_path", "registration_profile_sha256", "canvas_pixels", "ground_pivot", "footprint_world_points", "footprint_polygon_source", "frontage_sockets_source", "lod_profile", "coordinate_owner", "scale_source"],
      "properties": {
        "registration_contract": {"const": "CONTRACT-026"},
        "registration_profile_path": {"const": "docs/production/decisions/CONTRACT-026-registration-profiles-v1.json"},
        "registration_profile_sha256": {"const": "6663482339e953bdcbcb86bcfc876676989fbcb7f74a91f3f1b480d124fe3bd8"},
        "canvas_pixels": {"const": [1536, 1024]},
        "ground_pivot": {"const": [768, 896]},
        "footprint_world_points": {"const": [1, 1]},
        "footprint_polygon_source": {"const": [[768, 640], [1024, 768], [768, 896], [512, 768]]},
        "frontage_sockets_source": {"const": {"north": [896, 704], "east": [896, 832], "south": [640, 832], "west": [640, 704]}},
        "lod_profile": {"const": {"block": {"canvas": [1024, 683], "filter": "lanczos", "rounding": "round-half-even"}, "neighborhood": {"canvas": [512, 342], "filter": "lanczos", "rounding": "round-half-even"}, "city": {"canvas": [256, 171], "filter": "lanczos", "rounding": "round-half-even"}}},
        "coordinate_owner": {"const": "PLAY-096 code-owned registration table"},
        "scale_source": {"const": "CONTRACT-026-full-canvas-registration"}
      }
    },
    "readiness": {
      "type": "object", "additionalProperties": false,
      "required": ["candidateReadyForIndependentReview", "sourceReady", "integrationAdmitted", "rendererQuarantined", "productionSelected", "consumerReadiness"],
      "properties": {
        "candidateReadyForIndependentReview": {"type": "boolean"},
        "sourceReady": {"const": false}, "integrationAdmitted": {"const": false}, "rendererQuarantined": {"const": false}, "productionSelected": {"const": false},
        "consumerReadiness": {
          "type": "object", "additionalProperties": false,
          "required": ["PLAY-097", "PLAY-098", "PLAY-099", "PLAY-100", "PLAY-101", "PLAY-102", "PLAY-103", "PLAY-104", "PLAY-105"],
          "properties": {
            "PLAY-097": {"const": false}, "PLAY-098": {"const": false}, "PLAY-099": {"const": false}, "PLAY-100": {"const": false}, "PLAY-101": {"const": false}, "PLAY-102": {"const": false}, "PLAY-103": {"const": false}, "PLAY-104": {"const": false}, "PLAY-105": {"const": false}
          }
        }
      }
    }
  }
}
