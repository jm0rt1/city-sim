          "properties": {
            "schema": {
              "const": "atomic-admission-ledger-v1"
            },
            "disposition": {
              "const": "ready_for_atomic_assembly_nonshipping"
            },
            "runtimeActivated": {
              "const": false
            },
            "shippingResourcesMutated": {
              "const": false
            },
            "productionSelected": {
              "const": false
            }
          }
        }
      }
