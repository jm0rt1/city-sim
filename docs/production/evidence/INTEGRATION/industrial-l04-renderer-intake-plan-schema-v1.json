          "properties": {
            "commit": {
              "$ref": "#/$defs/commit"
            },
            "catalog": {
              "$ref": "#/$defs/artifact"
            },
            "industrialL3Manifest": {
              "$ref": "#/$defs/artifact"
            }
          }
        },
        "directions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/manifestDirectionTemplate"
          }
        },
        "runtimeActivated": {
          "const": false
        },
        "shippingResourcesMutated": {
          "const": false
        },
        "productionSelected": {
          "const": false
        }
      }
